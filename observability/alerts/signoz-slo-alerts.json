{
  "_comment": "SLO burn-rate alerts as code — implements ci/observability/slo/slos.yaml (import via POST /api/v1/alerts, same shape as signoz-alerts.json). Fast burn = 14.4x budget over 1h (page-class); slow burn = 6x over 6h (ticket-class). Denominators are small at ~50 bots: a breach means INVESTIGATE NOW, not panic — the math is in slos.yaml. The offline-window SLO is a latency threshold, so it uses long eval windows instead of burn factors.",
  "alerts": [
    {
      "alert": "XenomitSLOAvailabilityFastBurn",
      "alertType": "METRIC_BASED_ALERT",
      "ruleType": "RULE_TYPE_THRESHOLD",
      "severity": "critical",
      "condition": {
        "compositeQuery": {
          "queryType": "promql",
          "promQueries": {
            "A": { "query": "1 - (sum(xenomit_bot_phase{phase=~\"running|armed|draining|snapshotting|starting\"}) / sum(xenomit_bot_phase{phase!~\"needs_human|paused|stopped|invalid_config\"})) > 0.072", "disabled": false }
          },
          "panelType": "TIME_SERIES",
          "unit": "none"
        },
        "op": "1",
        "target": 0,
        "matchType": "1",
        "selectedQueryName": "A"
      },
      "labels": { "team": "fleet", "slo": "fleet-availability", "burn": "fast" },
      "annotations": {
        "summary": "Availability error budget burning 14.4x (1h window) — 99.5% SLO at risk",
        "description": "More than ~7% of desired bots out of live phases for an hour sustained. Check phase breakdown by cause — mass pending/quarantined vs a rollout wave — then runbooks: crash-quarantine / fenced-loops / registry-outage."
      },
      "evalWindow": "60m0s",
      "frequency": "5m0s",
      "broadcastToAll": false,
      "disabled": false
    },
    {
      "alert": "XenomitSLOAvailabilitySlowBurn",
      "alertType": "METRIC_BASED_ALERT",
      "ruleType": "RULE_TYPE_THRESHOLD",
      "severity": "warning",
      "condition": {
        "compositeQuery": {
          "queryType": "promql",
          "promQueries": {
            "A": { "query": "1 - (sum(xenomit_bot_phase{phase=~\"running|armed|draining|snapshotting|starting\"}) / sum(xenomit_bot_phase{phase!~\"needs_human|paused|stopped|invalid_config\"})) > 0.030", "disabled": false }
          },
          "panelType": "TIME_SERIES",
          "unit": "none"
        },
        "op": "1",
        "target": 0,
        "matchType": "1",
        "selectedQueryName": "A"
      },
      "labels": { "team": "fleet", "slo": "fleet-availability", "burn": "slow" },
      "annotations": {
        "summary": "Availability error budget burning 6x (6h window)",
        "description": "Sustained degraded availability — budget exhausted in ~5d at this rate. Same triage as fast burn; if both fire, work the fast-burn cause first."
      },
      "evalWindow": "360m0s",
      "frequency": "15m0s",
      "broadcastToAll": false,
      "disabled": false
    },
    {
      "alert": "XenomitSLOOfflineWindowSlowBreach",
      "alertType": "METRIC_BASED_ALERT",
      "ruleType": "RULE_TYPE_THRESHOLD",
      "severity": "warning",
      "condition": {
        "compositeQuery": {
          "queryType": "promql",
          "promQueries": {
            "A": { "query": "histogram_quantile(0.95, sum by (le) (rate(xenomit_handoff_offline_window_bucket[6h])))", "disabled": false }
          },
          "panelType": "TIME_SERIES",
          "unit": "s"
        },
        "op": "1",
        "target": 45,
        "matchType": "1",
        "selectedQueryName": "A"
      },
      "labels": { "team": "fleet", "slo": "handoff-offline-window-p95", "burn": "slow" },
      "annotations": {
        "summary": "Handoff offline-window p95 >45s sustained over 6h",
        "description": "Slow-window counterpart of XenomitOfflineWindowSLOBreach (1h). Sustained p95 breach means handoffs are systematically slow — drain waits, login latency, or cold image pulls; the Rollout Progress dashboard splits the phases."
      },
      "evalWindow": "360m0s",
      "frequency": "15m0s",
      "broadcastToAll": false,
      "disabled": false
    },
    {
