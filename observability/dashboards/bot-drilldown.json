{
  "title": "Xenomit — Per-bot Drill-down",
  "description": "docs/06 §6.7. Filter with the $bot_id variable (bound to the xenomit.bot.id resource attribute; SigNoz exposes it as the xenomit_bot_id label on botd metrics).",
  "tags": ["xenomit", "bot"],
  "version": "v4",
  "uploadedGrafana": false,
  "layout": [
    { "h": 3, "i": "phase", "w": 24, "x": 0, "y": 0 },
    { "h": 4, "i": "login", "w": 8, "x": 0, "y": 3 },
    { "h": 4, "i": "tick", "w": 8, "x": 8, "y": 3 },
    { "h": 4, "i": "restarts", "w": 8, "x": 16, "y": 3 },
    { "h": 4, "i": "stats", "w": 12, "x": 0, "y": 7 },
    { "h": 4, "i": "rewards", "w": 12, "x": 12, "y": 7 }
  ],
  "panels": [
    {
      "id": "phase",
      "title": "Phase (current)",
      "panelTypes": "VALUE",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "sum by (phase) (xenomit_bot_phase{xenomit_bot_id=~\"$bot_id\"})", "legend": "{{phase}}", "disabled": false }
        ]
      }
    },
    {
      "id": "login",
      "title": "Login duration p95",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "histogram_quantile(0.95, sum by (le) (rate(xenomit_login_duration_bucket{xenomit_bot_id=~\"$bot_id\"}[30m])))", "legend": "p95", "disabled": false }
        ]
      }
    },
    {
      "id": "tick",
      "title": "Tick duration p95 by module",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "histogram_quantile(0.95, sum by (le, module) (rate(xenomit_runtime_tick_duration_bucket{xenomit_bot_id=~\"$bot_id\"}[15m])))", "legend": "{{module}}", "disabled": false }
        ]
      }
    },
    {
      "id": "restarts",
      "title": "Process restarts (1h)",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "increase(xenomit_bot_restarts{xenomit_bot_id=~\"$bot_id\"}[1h])", "legend": "restarts", "disabled": false }
        ]
      }
    },
    {
      "id": "stats",
      "title": "Stat events (5m rate)",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "rate(xenomit_stats_events{xenomit_bot_id=~\"$bot_id\"}[5m])", "legend": "events/s", "disabled": false }
        ]
      }
    },
    {
      "id": "rewards",
      "title": "Rewards per hour",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "sum by (asset, module) (xenomit_bot_rewards_per_hour{xenomit_bot_id=~\"$bot_id\"})", "legend": "{{asset}}/{{module}}", "disabled": false }
        ]
      }
    }
  ],
  "variables": {
    "bot_id": {
      "type": "QUERY",
      "name": "bot_id",
      "label": "Bot",
      "description": "xenomit.bot.id resource attribute",
      "queryValue": "label_values(xenomit_bot_phase, xenomit_bot_id)",
      "customValue": "",
      "textboxValue": "",
      "multiSelect": true,
      "showALLOption": true,
      "sort": "ASC",
      "refresh": "onDashboardLoad"
    }
  }
}
