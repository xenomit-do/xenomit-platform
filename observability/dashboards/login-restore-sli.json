{
  "title": "Xenomit — Login & Restore SLIs",
  "description": "docs/06 §6.7 + the SLO proposals of docs/04 §4.4: availability ≥ 99.5%/mo, clean-restore ≥ 99%, drain-to-safe-point p95 ≤ 120 s, offline window p95 ≤ 45 s.",
  "tags": ["xenomit", "slo"],
  "version": "v4",
  "uploadedGrafana": false,
  "layout": [
    { "h": 3, "i": "restore-sli", "w": 8, "x": 0, "y": 0 },
    { "h": 3, "i": "login-success", "w": 8, "x": 8, "y": 0 },
    { "h": 3, "i": "availability", "w": 8, "x": 16, "y": 0 },
    { "h": 4, "i": "login-p95", "w": 12, "x": 0, "y": 3 },
    { "h": 4, "i": "drain-p95", "w": 12, "x": 12, "y": 3 }
  ],
  "panels": [
    {
      "id": "restore-sli",
      "title": "Clean restore ratio (24h, SLO ≥ 99%)",
      "panelTypes": "VALUE",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "sum(increase(xenomit_snapshot_restore_total{outcome=\"clean\"}[24h])) / sum(increase(xenomit_snapshot_restore_total[24h]))", "legend": "clean ratio", "disabled": false }
        ]
      }
    },
    {
      "id": "login-success",
      "title": "Login success ratio (24h)",
      "panelTypes": "VALUE",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "1 - (sum(rate(xenomit_login_duration_count{outcome=\"failed\"}[24h])) / sum(rate(xenomit_login_duration_count[24h])))", "legend": "success", "disabled": false }
        ]
      }
    },
    {
      "id": "availability",
      "title": "Fleet availability (SLO ≥ 99.5%)",
      "description": "Running+Armed+Draining share of desired bots — user-caused states (needs_human, user-paused) excluded per docs/04 §4.4.",
      "panelTypes": "VALUE",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "sum(xenomit_bot_phase{phase=~\"running|armed|draining|snapshotting|starting\"}) / sum(xenomit_bot_phase{phase!~\"needs_human|paused|stopped|invalid_config\"})", "legend": "availability", "disabled": false }
        ]
      }
    },
    {
      "id": "login-p95",
      "title": "Login duration p95",
      "description": "Expected 5–15 s against the real game (docs/10 assumption).",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "histogram_quantile(0.95, sum by (le) (rate(xenomit_login_duration_bucket[1h])))", "legend": "p95", "disabled": false },
          { "query": "histogram_quantile(0.50, sum by (le) (rate(xenomit_login_duration_bucket[1h])))", "legend": "p50", "disabled": false }
        ]
      }
    },
    {
      "id": "drain-p95",
      "title": "Drain-to-safe-point p95 (SLO ≤ 120 s)",
      "description": "Handoff duration with reason=upgrade|config_requires_restart approximates drain wait.",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "histogram_quantile(0.95, sum by (le) (rate(xenomit_handoff_duration_bucket[1h])))", "legend": "p95", "disabled": false },
          { "query": "120", "legend": "SLO", "disabled": false }
        ]
      }
    }
  ],
  "variables": {}
}
