{
  "title": "Xenomit — SLO Overview",
  "description": "Phase-9 SLOs (ci/observability/slo/slos.yaml): availability 99.5%, offline-window p95 ≤45s, restore ≥99%, login ≥98%. Value panels read the SLI over the 30d window; burn panels show the fast/slow budget burn the alerts in alerts/signoz-slo-alerts.json key on.",
  "tags": ["xenomit", "slo"],
  "version": "v1",
  "uploadedGrafana": false,
  "layout": [
    { "h": 3, "i": "slo-availability", "w": 6, "x": 0,  "y": 0 },
    { "h": 3, "i": "slo-restore",      "w": 6, "x": 6,  "y": 0 },
    { "h": 3, "i": "slo-login",        "w": 6, "x": 12, "y": 0 },
    { "h": 3, "i": "slo-offline-p95",  "w": 6, "x": 18, "y": 0 },
    { "h": 5, "i": "availability-burn","w": 12,"x": 0,  "y": 3 },
    { "h": 5, "i": "restore-burn",     "w": 12,"x": 12, "y": 3 },
    { "h": 5, "i": "login-burn",       "w": 12,"x": 0,  "y": 8 },
    { "h": 5, "i": "offline-window",   "w": 12,"x": 12, "y": 8 }
  ],
  "panels": [
    {
      "id": "slo-availability",
      "title": "Availability (30d, SLO ≥ 99.5%)",
      "panelTypes": "VALUE",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "avg_over_time((sum(xenomit_bot_phase{phase=~\"running|armed|draining|snapshotting|starting\"}) / sum(xenomit_bot_phase{phase!~\"needs_human|paused|stopped|invalid_config\"}))[30d:5m])", "legend": "availability", "disabled": false }
        ]
      }
    },
    {
      "id": "slo-restore",
      "title": "Restore success (30d, SLO ≥ 99%)",
      "panelTypes": "VALUE",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "1 - (sum(increase(xenomit_snapshot_restore_total{outcome=\"failed\"}[30d])) / sum(increase(xenomit_snapshot_restore_total[30d])))", "legend": "success", "disabled": false }
        ]
      }
    },
    {
      "id": "slo-login",
      "title": "Login success (30d, SLO ≥ 98%)",
      "description": "Includes user-caused failures until outcome gains a cause label (slos.yaml).",
      "panelTypes": "VALUE",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "1 - (sum(rate(xenomit_login_duration_count{outcome=\"failed\"}[30d])) / sum(rate(xenomit_login_duration_count[30d])))", "legend": "success", "disabled": false }
        ]
      }
    },
    {
      "id": "slo-offline-p95",
      "title": "Offline window p95 (1h, SLO ≤ 45s)",
      "panelTypes": "VALUE",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "histogram_quantile(0.95, sum by (le) (rate(xenomit_handoff_offline_window_bucket[1h])))", "legend": "p95 s", "disabled": false }
        ]
      }
    },
    {
      "id": "availability-burn",
      "title": "Availability error rate vs budget (fast 0.072 / slow 0.030)",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "1 - (sum(xenomit_bot_phase{phase=~\"running|armed|draining|snapshotting|starting\"}) / sum(xenomit_bot_phase{phase!~\"needs_human|paused|stopped|invalid_config\"}))", "legend": "error rate", "disabled": false },
          { "query": "vector(0.072)", "legend": "fast-burn 14.4x", "disabled": false },
          { "query": "vector(0.030)", "legend": "slow-burn 6x", "disabled": false }
        ]
      }
    },
    {
      "id": "restore-burn",
      "title": "Restore failure ratio (fast 0.144 / slow 0.060)",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "sum(increase(xenomit_snapshot_restore_total{outcome=\"failed\"}[1h])) / sum(increase(xenomit_snapshot_restore_total[1h]))", "legend": "1h ratio", "disabled": false },
          { "query": "sum(increase(xenomit_snapshot_restore_total{outcome=\"failed\"}[6h])) / sum(increase(xenomit_snapshot_restore_total[6h]))", "legend": "6h ratio", "disabled": false },
          { "query": "vector(0.144)", "legend": "fast-burn", "disabled": false },
          { "query": "vector(0.060)", "legend": "slow-burn", "disabled": false }
        ]
      }
    },
    {
      "id": "login-burn",
      "title": "Login failure ratio (fast 0.288 / slow 0.120)",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "sum(rate(xenomit_login_duration_count{outcome=\"failed\"}[1h])) / sum(rate(xenomit_login_duration_count[1h]))", "legend": "1h ratio", "disabled": false },
          { "query": "sum(rate(xenomit_login_duration_count{outcome=\"failed\"}[6h])) / sum(rate(xenomit_login_duration_count[6h]))", "legend": "6h ratio", "disabled": false },
          { "query": "vector(0.288)", "legend": "fast-burn", "disabled": false },
          { "query": "vector(0.120)", "legend": "slow-burn", "disabled": false }
        ]
      }
    },
    {
      "id": "offline-window",
      "title": "Offline-window p95 (1h vs 6h, SLO ≤ 45s)",
      "panelTypes": "TIME_SERIES",
      "query": {
        "queryType": "promql",
        "promql": [
          { "query": "histogram_quantile(0.95, sum by (le) (rate(xenomit_handoff_offline_window_bucket[1h])))", "legend": "1h p95", "disabled": false },
          { "query": "histogram_quantile(0.95, sum by (le) (rate(xenomit_handoff_offline_window_bucket[6h])))", "legend": "6h p95", "disabled": false },
          { "query": "vector(45)", "legend": "SLO 45s", "disabled": false }
        ]
      }
    }
  ]
}
