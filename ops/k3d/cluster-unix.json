{
  "apiVersion": "k3d.io/v1alpha5",
  "kind": "Simple",
  "metadata": {
    "name": "xenomit"
  },
  "servers": 1,
  "agents": 0,
  "image": "rancher/k3s:v1.36.5-k3s1",
  "kubeAPI": {
    "host": "127.0.0.1",
    "hostIP": "127.0.0.1",
    "hostPort": "6443"
  },
  "ports": [
    {
      "port": "127.0.0.1:8080:30080",
      "nodeFilters": [
        "server:0"
      ]
    }
  ],
  "options": {
    "k3d": {
      "wait": true,
      "timeout": "180s"
    },
    "kubeconfig": {
      "updateDefaultKubeconfig": false,
      "switchCurrentContext": false
    }
  }
}
