# syntax=docker/dockerfile:1
#
# `xenomit-packet-updater` — in-cluster detect → apply → PR tool
# (docs/07 §7.1). One image serves both stages:
#   * CronJob `detect`  — hash check (+ kubectl to spawn the apply Job)
#   * Job     `apply`   — FFDec decompile, rewrites, git push, PR
#
# Build context: repos root.
#
#   docker build -f ci/docker/Dockerfile.packet-updater \
#     -t xenomit-packet-updater .

# JRE for FFDec (kept out of the final stage's apt list via a clean copy).
FROM eclipse-temurin:21-jre AS jre

FROM python:3.13-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash ca-certificates curl unzip git jq openssh-client \
 && rm -rf /var/lib/apt/lists/*

COPY --from=jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# kubectl — pinned to the k3d server version (ops/k3d/cluster.yaml).
ARG KUBECTL_VERSION=v1.30.4
RUN curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
      -o /usr/local/bin/kubectl \
 && chmod +x /usr/local/bin/kubectl

# FFDec CLI. Pin the release; verify the asset name before relying on it —
# upstream publishes ffdec_<version>.zip under tag version<version>.
ARG FFDEC_VERSION=24.1.0
RUN curl -fsSL \
      "https://github.com/jindrapetrik/jpexs-decompiler/releases/download/version${FFDEC_VERSION}/ffdec_${FFDEC_VERSION}.zip" \
      -o /tmp/ffdec.zip \
 && unzip -q /tmp/ffdec.zip -d /opt/ffdec \
 && rm /tmp/ffdec.zip \
 && chmod +x /opt/ffdec/ffdec.sh \
 && ln -s /opt/ffdec/ffdec.sh /usr/local/bin/ffdec
ENV FFDEC=/opt/ffdec/ffdec.sh

# The tool itself (pure Python, no deps).
COPY xenomit-packet-updater/ /opt/xenomit-packet-updater/
RUN pip install --no-cache-dir /opt/xenomit-packet-updater

# The detect→PR orchestration script the CronJob/Job manifests invoke.
COPY xenomit-orchestrator/ci/packet-updater/detect-pr-flow.sh /usr/local/bin/detect-pr-flow.sh
RUN chmod +x /usr/local/bin/detect-pr-flow.sh

# Writable HOME for git config + ssh known_hosts; run as non-root.
RUN useradd -m -u 10001 updater
USER updater
WORKDIR /home/updater

# Subcommand comes from the CronJob/Job args: detect | apply | check
ENTRYPOINT ["/usr/local/bin/detect-pr-flow.sh"]
CMD ["detect"]
